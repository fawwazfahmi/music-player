<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job: nightly Kyowave backup.

  Runs scripts/backup.sh once per day at 03:00 local time. The script
  dumps the database (custom-format) and tars the music library into
  ~/Backups/Kyowave/<timestamp>/, pruning anything older than 30
  days.

  Install:
    cp deploy/launchd/com.kyowave.backup.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.kyowave.backup.plist

  Run on demand (without waiting for 03:00):
    launchctl start com.kyowave.backup
    tail -f ~/Library/Logs/Kyowave/backup.out.log

  RunAtLoad is false on purpose — we only want the scheduled run, not a
  backup every time the Mac boots.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kyowave.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/fwzfhmy/Projects/music-player/scripts/backup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/fwzfhmy/Projects/music-player</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- Mirror today's db.dump (and Sunday's music.tar.gz) to iCloud
             Drive so the only copy isn't on the same SSD as the source.
             A dead disk would otherwise take both at once. -->
        <key>OFFSITE_DIR</key>
        <string>/Users/fwzfhmy/Library/Mobile Documents/com~apple~CloudDocs/Kyowave-Backups</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/fwzfhmy/Library/Logs/Kyowave/backup.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/fwzfhmy/Library/Logs/Kyowave/backup.err.log</string>
</dict>
</plist>
