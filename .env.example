# Database
DATABASE_URL="postgresql://music:music@localhost:5432/music_universe"

# Filesystem
MUSIC_LIBRARY_PATH="/srv/music"

# YT (binary paths — used in Phase 2+)
# Homebrew installs to /opt/homebrew on Apple Silicon and /usr/local on Intel.
# These must be absolute paths to a real binary — check with `which yt-dlp`,
# `which ffmpeg`. A stale path here fails at the point of use, not at boot:
# env.ts only validates that the string is non-empty.
YT_DLP_PATH="/opt/homebrew/bin/yt-dlp"
FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"

# MusicBrainz etiquette (used in Phase 4)
MUSICBRAINZ_USER_AGENT="Kyowave/1.0 ( your-email@example.com )"

# Auth
# Generate hash:   pnpm exec node -e "import('bcryptjs').then(b => console.log(b.default.hashSync('your-password', 12)))"
# IMPORTANT: bcrypt hashes contain $ characters which dotenv-expand treats as shell variable
# references. Escape EVERY $ as \$ in the value below, e.g. "\$2b\$12\$..." — dotenv-expand
# will turn the \$ back into $ after expansion, so bcryptjs receives the correct hash.
APP_PASSWORD_HASH="\$2b\$12\$replace-with-real-bcrypt-hash"

# Generate secret: pnpm exec node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="replace-with-32-plus-random-bytes-hex"

# Per-user YouTube cookie jars (optional). Makes a pasted Mix resolve as that
# person's YouTube account instead of an anonymous cold-start radio.
# MUST be outside MUSIC_LIBRARY_PATH and outside Postgres: scripts/backup.sh
# tars the library and pg_dumps the DB, and both are mirrored offsite — a jar
# in either would ship live Google session credentials to the backup target.
# Defaults to ~/.config/kyowave/yt-cookies when unset.
YT_COOKIES_DIR="/srv/secrets/yt-cookies"

# Local Ollama (optional) — powers genre/mood intelligence. Defaults shown.
# When unreachable, genre/mood features degrade gracefully instead of failing.
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.1:8b"
