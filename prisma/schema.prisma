generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== Core music entities =====

model Artist {
  id              String    @id @default(cuid())
  name            String    @unique
  sortName        String?
  bio             String?
  photoUrl        String?
  discoveredAt    DateTime?
  mbid            String?   @unique
  metadataFetched DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  albums       Album[]
  tracks       Track[]              @relation("TrackPrimaryArtist")
  trackArtists TrackArtist[]
  genres       ArtistGenre[]
  tags         ArtistTag[]
  externalIds  ExternalIdentifier[] @relation("ArtistIds")
  favoritedBy  FavoriteArtist[]
  relatedFrom  RelatedArtist[]      @relation("ArtistFrom")
  relatedTo    RelatedArtist[]      @relation("ArtistTo")

  @@index([name])
  @@index([sortName])
}

model Album {
  id              String    @id @default(cuid())
  title           String
  sortTitle       String?
  releaseDate     DateTime?
  coverArtPath    String?
  coverArtHash    String?
  totalDuration   Int?
  artistId        String
  mbid            String?   @unique
  metadataFetched DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  artist      Artist               @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      Track[]
  genres      AlbumGenre[]
  tags        AlbumTag[]
  externalIds ExternalIdentifier[] @relation("AlbumIds")
  favoritedBy FavoriteAlbum[]

  @@unique([artistId, title])
  @@index([title])
  @@index([releaseDate])
}

model Track {
  id          String  @id @default(cuid())
  title       String
  sortTitle   String?
  duration    Int
  trackNumber Int?
  discNumber  Int?

  filePath   String? @unique
  fileSize   BigInt?
  fileFormat String?
  bitrate    Int?
  sha256     String? @unique

  source    TrackSource @default(LOCAL_SCAN)
  ytVideoId String?     @unique
  playable  Boolean     @default(true)

  albumId         String?
  primaryArtistId String
  mbid            String?   @unique
  metadataFetched DateTime?
  discoveredAt    DateTime?

  // Per-track cover override, chosen by hand in the cover picker. Takes
  // precedence over the album's art. Needed because every YouTube download by
  // one artist shares a single "YouTube" album, so album-level art can't
  // express "this one song's cover is wrong".
  coverArtHash String?

  // Lyrics (LRCLIB or Whisper-transcribed)
  lyricsSynced  String?
  lyricsPlain   String?
  lyricsSource  LyricsSource?
  lyricsFetched DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album             Album?               @relation(fields: [albumId], references: [id], onDelete: SetNull)
  primaryArtist     Artist               @relation("TrackPrimaryArtist", fields: [primaryArtistId], references: [id])
  additionalArtists TrackArtist[]
  tags              TrackTag[]
  genres            TrackGenre[]
  moodSeeds         TrackMoodSeed[]
  moodAffinities    TrackMoodAffinity[]
  moodFeedback      MoodFeedback[]
  notes             SongNote[]
  history           ListeningHistory[]
  playlistEntries   PlaylistTrack[]
  favoritedBy       FavoriteTrack[]
  externalIds       ExternalIdentifier[] @relation("TrackIds")
  ytCache           YtCacheEntry?

  @@index([title])
  @@index([albumId, trackNumber])
  @@index([primaryArtistId])
}

enum TrackSource {
  LOCAL_SCAN
  YT_CACHED
  YT_STREAMING
  UPLOAD
}

enum LyricsSource {
  LRCLIB_SYNCED
  LRCLIB_PLAIN
  WHISPER
  MANUAL
}

model TrackArtist {
  trackId  String
  artistId String
  role     String?
  track    Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
}

// ===== Genres & Tags =====

model Genre {
  id      String        @id @default(cuid())
  name    String        @unique
  mbid    String?       @unique
  artists ArtistGenre[]
  albums  AlbumGenre[]
  tracks  TrackGenre[]
}

model ArtistGenre {
  artistId String
  genreId  String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id])

  @@id([artistId, genreId])
}

model AlbumGenre {
  albumId String
  genreId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@id([albumId, genreId])
}

model TrackGenre {
  trackId String
  genreId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id])

  @@id([trackId, genreId])
  @@index([genreId])
}

// ===== Moods & self-learning =====

enum MoodKind {
  BUILTIN
  CUSTOM
}

enum AffinitySource {
  LLM_SEED
  HEURISTIC
}

enum FeedbackVerdict {
  FIT
  MISS
}

// The fixed learning axes. Built-ins are seeded on demand. Free-text moods do
// NOT create rows here — they live as an interpretation blend on MoodSession.
model Mood {
  id        String   @id @default(cuid())
  name      String   @unique // normalized key, e.g. "chill"
  label     String // display label, e.g. "Chill"
  emoji     String?
  kind      MoodKind @default(BUILTIN)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  seeds      TrackMoodSeed[]
  affinities TrackMoodAffinity[]
  sessions   MoodSession[]
}

// Listener-agnostic baseline affinity from the LLM/heuristic seeder. Shared by
// both listeners; per-listener learning lives in TrackMoodAffinity and is
// blended on top at query time.
model TrackMoodSeed {
  trackId String
  moodId  String
  score   Float          @default(0) // 0..1
  source  AffinitySource @default(LLM_SEED)
  track   Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  mood    Mood           @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@id([trackId, moodId])
  @@index([moodId])
}

// Per-listener learned signal. Created on first real feedback; the derived
// `score` is recomputed from the counters.
model TrackMoodAffinity {
  listener   String
  trackId    String
  moodId     String
  completes  Int      @default(0)
  skips      Int      @default(0)
  replays    Int      @default(0)
  thumbsUp   Int      @default(0)
  thumbsDown Int      @default(0)
  score      Float    @default(0)
  updatedAt  DateTime @updatedAt
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  mood       Mood     @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@id([listener, trackId, moodId])
  @@index([listener, moodId])
  @@index([moodId])
}

// One "she asked for a mood" event. `interpretation` is the JSON blend the
// engine used (weights over built-in moods + optional hints).
model MoodSession {
  id             String   @id @default(cuid())
  listener       String
  moodId         String?
  freeText       String?
  interpretation Json
  createdAt      DateTime @default(now())
  mood           Mood?    @relation(fields: [moodId], references: [id], onDelete: SetNull)
  feedback       MoodFeedback[]

  @@index([listener, createdAt])
}

// Explicit + derived per-track verdicts within a session. Feeds the affinity
// counters; kept as a log so scores can be re-derived if the formula changes.
model MoodFeedback {
  id        String          @id @default(cuid())
  sessionId String
  trackId   String
  verdict   FeedbackVerdict
  at        DateTime        @default(now())
  session   MoodSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  track     Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([trackId])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  color   String?
  tracks  TrackTag[]
  artists ArtistTag[]
  albums  AlbumTag[]
}

model TrackTag {
  trackId String
  tagId   String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([trackId, tagId])
}

model ArtistTag {
  artistId String
  tagId    String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([artistId, tagId])
}

model AlbumTag {
  albumId String
  tagId   String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([albumId, tagId])
}

// ===== Memory & personal data =====

model SongNote {
  id        String   @id @default(cuid())
  trackId   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, createdAt])
}

model FavoriteTrack {
  trackId     String   @id
  favoritedAt DateTime @default(now())
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model FavoriteAlbum {
  albumId     String   @id
  favoritedAt DateTime @default(now())
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model FavoriteArtist {
  artistId    String   @id
  favoritedAt DateTime @default(now())
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

// ===== Playlists =====

model Playlist {
  id             String          @id @default(cuid())
  name           String
  description    String?
  coverImagePath String?
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tracks         PlaylistTrack[]
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([playlistId, position])
}

// ===== Listening history =====

model ListeningHistory {
  id               String         @id @default(cuid())
  trackId          String
  playedAt         DateTime       @default(now())
  durationListened Int
  completed        Boolean        @default(false)
  source           PlaybackSource
  // Which of the two identities played this ("ainul" | "fawwaz"), from the
  // mu_name cookie. Nullable because a play can be recorded before login
  // resolves. Rows predating this column were backfilled to ainul.
  listener         String?
  track            Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playedAt])
  @@index([trackId, playedAt])
  @@index([listener, playedAt])
}

enum PlaybackSource {
  LOCAL_FILE
  YT_STREAM
  YT_CACHED
}

// ===== Artist relationships =====

model RelatedArtist {
  fromArtistId String
  toArtistId   String
  similarity   Float?
  source       String
  fromArtist   Artist @relation("ArtistFrom", fields: [fromArtistId], references: [id], onDelete: Cascade)
  toArtist     Artist @relation("ArtistTo", fields: [toArtistId], references: [id], onDelete: Cascade)

  @@id([fromArtistId, toArtistId, source])
}

// ===== Metadata caching =====

model ExternalIdentifier {
  id         String             @id @default(cuid())
  entityType ExternalEntityType
  source     String
  externalId String
  artistId   String?
  albumId    String?
  trackId    String?
  artist     Artist?            @relation("ArtistIds", fields: [artistId], references: [id], onDelete: Cascade)
  album      Album?             @relation("AlbumIds", fields: [albumId], references: [id], onDelete: Cascade)
  track      Track?             @relation("TrackIds", fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([source, externalId, entityType])
  @@index([artistId])
  @@index([albumId])
  @@index([trackId])
}

enum ExternalEntityType {
  ARTIST
  ALBUM
  TRACK
}

// ===== YouTube cache =====

model YtCacheEntry {
  ytVideoId       String        @id
  trackId         String?       @unique
  status          YtCacheStatus
  downloadedBytes BigInt        @default(0)
  totalBytes      BigInt?
  localFilePath   String?
  errorMessage    String?
  attempts        Int           @default(0)
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  track           Track?        @relation(fields: [trackId], references: [id], onDelete: SetNull)
}

enum YtCacheStatus {
  PENDING
  DOWNLOADING
  READY
  FAILED
}

// ===== Metadata enrichment jobs =====

model MetadataJob {
  id          String             @id @default(cuid())
  entityType  ExternalEntityType
  artistId    String?
  albumId     String?
  trackId     String?
  status      JobStatus
  attempts    Int                @default(0)
  lastError   String?
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// ===== Settings =====

model AppSetting {
  key   String @id
  value String
}

// ===== Listening Party =====

// Singleton-ish: at most one row with active=true at a time. The server
// enforces this when starting a new party (ends any existing one first).
//
// All clients on the receiver side poll for the row where active=true and
// hard-sync their player to (trackId, position, isPlaying).
model ListeningParty {
  id            String   @id @default(cuid())
  active        Boolean  @default(true)
  startedBy     String
  trackId       String?
  /** Seconds into the current track. The broadcaster writes this on every
      seek and roughly every second during playback. */
  position      Float    @default(0)
  isPlaying     Boolean  @default(false)
  /** Increments on every broadcaster write so the receiver can detect new
      updates without comparing all fields. */
  pulse         Int      @default(0)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  updatedAt     DateTime @updatedAt
  /** Last moment the party was actually playing (isPlaying=true). Refreshed
      only on playing updates, so a paused heartbeat does NOT refresh it. Used
      to auto-end a party that's been idle (paused or disconnected) too long. */
  lastPlayingAt DateTime @default(now())

  @@index([active, updatedAt])
}
